[Unit]
Description=Braverave Escalation Guard
After=network-online.target
Wants=network-online.target
# Лимит перезапусков намеренно выключен. С окном в 300 секунд и пятью
# попытками моргнувший 25.09.2026 DNS увёл сервис в failed на 17 дней:
# systemd сдался раньше, чем сеть вернулась. Для внутреннего бота
# доступность важнее вежливости к systemd, а от настоящего цикла падений
# защищает RestartSec.
StartLimitIntervalSec=0

[Service]
Type=simple
User=escalation
WorkingDirectory=/opt/escalation-guard
EnvironmentFile=/opt/escalation-guard/.env
ExecStart=/opt/escalation-guard/.venv/bin/python -m guard.main
Restart=always
RestartSec=30
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
ReadWritePaths=/var/lib/escalation-guard
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
